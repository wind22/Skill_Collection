#!/usr/bin/env bash
set -euo pipefail
umask 077

VERSION="0.2.0"

HOST="prompt"
SELECT_ALL="0"
ASSUME_YES="0"
LIST_ONLY="0"
DRY_RUN="0"
OVERWRITE="0"
INSTALL_MODE="link"
QUIET="0"
CODEX_DEST=""
CLAUDE_DEST=""
SOURCE_DIR_OVERRIDE=""
REQUESTED_SKILLS=()

usage() {
  cat <<'EOF'
Skill Collection setup

Usage:
  ./setup
  ./setup --host auto
  ./setup --host both --all
  ./setup --host codex --skill improve-questions

Options:
  --host codex|claude|both|auto|prompt  Install target. Default: prompt.
  --all                                 Install every skill in skills/.
  --skill NAME                          Install one skill. Can be repeated.
  --list                                List installable skills and exit.
  --link                                Symlink skills into the host. Default on macOS/Linux.
  --copy                                Copy skills into the host. Default on Windows.
  --overwrite                           Replace existing non-symlink skills after backup.
  --dry-run                             Show what would happen without changing files.
  --yes                                 Accept defaults for prompts.
  --quiet                               Print less output.
  --codex-dir DIR                       Override Codex skills destination.
  --claude-dir DIR                      Override Claude Code skills destination.
  -h, --help                            Show this help.

Compatibility aliases:
  --target                              Same as --host.
  --codex-dest                          Same as --codex-dir.
  --claude-dest                         Same as --claude-dir.
  --source                              Install from another local collection.

Environment:
  CODEX_SKILLS_DIR                      Exact Codex skills destination.
  CODEX_HOME                            Codex home, defaults to ~/.codex.
  CLAUDE_SKILLS_DIR                     Exact Claude Code skills destination.
  CLAUDE_HOME                           Claude home, defaults to ~/.claude.
EOF
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

log() {
  [[ "${QUIET}" == "1" ]] || printf '%s\n' "$*"
}

has_tty() {
  [[ -r /dev/tty && -w /dev/tty ]]
}

prompt_read() {
  local prompt="$1"
  local reply=""

  if has_tty; then
    printf '%s' "${prompt}" > /dev/tty
    IFS= read -r reply < /dev/tty
  else
    printf '%s' "${prompt}" >&2
    IFS= read -r reply
  fi

  printf '%s' "${reply}"
}

script_dir() {
  local source="${BASH_SOURCE[0]:-$0}"
  cd "$(dirname "${source}")" >/dev/null 2>&1
  pwd -P
}

append_skill() {
  [[ -n "$1" ]] || die "--skill requires a non-empty name"
  REQUESTED_SKILLS+=("$1")
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host|--target)
      [[ $# -ge 2 ]] || die "$1 requires codex, claude, both, auto, or prompt"
      HOST="$2"
      shift 2
      ;;
    --host=*|--target=*)
      HOST="${1#*=}"
      shift
      ;;
    --all)
      SELECT_ALL="1"
      shift
      ;;
    --skill)
      [[ $# -ge 2 ]] || die "--skill requires a name"
      append_skill "$2"
      shift 2
      ;;
    --skill=*)
      append_skill "${1#--skill=}"
      shift
      ;;
    --list)
      LIST_ONLY="1"
      shift
      ;;
    --link)
      INSTALL_MODE="link"
      shift
      ;;
    --copy)
      INSTALL_MODE="copy"
      shift
      ;;
    --overwrite)
      OVERWRITE="1"
      shift
      ;;
    --skip-existing)
      OVERWRITE="0"
      shift
      ;;
    --dry-run)
      DRY_RUN="1"
      shift
      ;;
    --yes|-y)
      ASSUME_YES="1"
      shift
      ;;
    --quiet|-q)
      QUIET="1"
      shift
      ;;
    --codex-dir|--codex-dest)
      [[ $# -ge 2 ]] || die "$1 requires a directory"
      CODEX_DEST="$2"
      shift 2
      ;;
    --claude-dir|--claude-dest)
      [[ $# -ge 2 ]] || die "$1 requires a directory"
      CLAUDE_DEST="$2"
      shift 2
      ;;
    --source)
      [[ $# -ge 2 ]] || die "--source requires a directory"
      SOURCE_DIR_OVERRIDE="$2"
      shift 2
      ;;
    --source=*)
      SOURCE_DIR_OVERRIDE="${1#--source=}"
      shift
      ;;
    --version)
      printf '%s\n' "${VERSION}"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        append_skill "$1"
        shift
      done
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      append_skill "$1"
      shift
      ;;
  esac
done

case "${HOST}" in
  prompt|codex|claude|both|all|auto) ;;
  *) die "--host must be codex, claude, both, auto, or prompt" ;;
esac

if [[ "${HOST}" == "all" ]]; then
  HOST="both"
fi

if [[ -n "${SOURCE_DIR_OVERRIDE}" ]]; then
  SOURCE_DIR="$(cd "${SOURCE_DIR_OVERRIDE}" >/dev/null 2>&1 && pwd -P)" || die "source directory not found: ${SOURCE_DIR_OVERRIDE}"
else
  SOURCE_DIR="$(script_dir)"
fi
SKILLS_DIR="${SOURCE_DIR}/skills"
[[ -d "${SKILLS_DIR}" ]] || die "no skills directory found at ${SKILLS_DIR}"

CODEX_DEST="${CODEX_DEST:-${CODEX_SKILLS_DIR:-${CODEX_HOME:-${HOME}/.codex}/skills}}"
CLAUDE_DEST="${CLAUDE_DEST:-${CLAUDE_SKILLS_DIR:-${CLAUDE_HOME:-${HOME}/.claude}/skills}}"

IS_WINDOWS="0"
case "$(uname -s 2>/dev/null || printf unknown)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) IS_WINDOWS="1" ;;
esac

if [[ "${IS_WINDOWS}" == "1" && "${INSTALL_MODE}" == "link" ]]; then
  INSTALL_MODE="copy"
fi

SKILL_NAMES=()
SKILL_PATHS=()
SKILL_DESCRIPTIONS=()

read_description() {
  local file="$1"
  awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    capture_description {
      if ($0 ~ /^[[:space:]]+/) {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        if (line != "") {
          description = description ? description " " line : line
        }
        next
      }
      print description
      printed = 1
      exit
    }
    in_frontmatter && /^description:[[:space:]]*/ {
      sub(/^description:[[:space:]]*/, "")
      gsub(/^"/, "")
      gsub(/"$/, "")
      if ($0 == ">" || $0 == "|") {
        capture_description = 1
        next
      }
      print
      printed = 1
      exit
    }
    END {
      if (capture_description && description != "" && !printed) {
        print description
      }
    }
  ' "$file"
}

discover_skills() {
  local dir=""
  local name=""
  local skill_md=""
  local description=""

  for dir in "${SKILLS_DIR}"/*; do
    [[ -d "${dir}" ]] || continue
    name="$(basename "${dir}")"
    [[ "${name}" == .* || "${name}" == _* ]] && continue
    skill_md="${dir}/SKILL.md"
    [[ -f "${skill_md}" ]] || continue

    description="$(read_description "${skill_md}")"
    SKILL_NAMES+=("${name}")
    SKILL_PATHS+=("${dir}")
    SKILL_DESCRIPTIONS+=("${description:-No description}")
  done
}

print_skills() {
  local i=0

  if [[ "${#SKILL_NAMES[@]}" -eq 0 ]]; then
    log "No installable skills found in ${SKILLS_DIR}."
    return
  fi

  log "Installable skills from ${SOURCE_DIR}:"
  for ((i = 0; i < ${#SKILL_NAMES[@]}; i++)); do
    printf '  %2d. %-28s %s\n' "$((i + 1))" "${SKILL_NAMES[$i]}" "${SKILL_DESCRIPTIONS[$i]}"
  done
}

find_skill_index() {
  local query="$1"
  local i=0

  if [[ "${query}" =~ ^[0-9]+$ ]]; then
    if [[ "${query}" -ge 1 && "${query}" -le "${#SKILL_NAMES[@]}" ]]; then
      printf '%s' "$((query - 1))"
      return 0
    fi
  fi

  for ((i = 0; i < ${#SKILL_NAMES[@]}; i++)); do
    if [[ "${SKILL_NAMES[$i]}" == "${query}" ]]; then
      printf '%s' "${i}"
      return 0
    fi
  done

  return 1
}

array_contains() {
  local needle="$1"
  shift
  local item=""

  for item in "$@"; do
    [[ "${item}" == "${needle}" ]] && return 0
  done

  return 1
}

SELECTED_INDEXES=()

add_selected_index() {
  local index="$1"

  if ! array_contains "${index}" "${SELECTED_INDEXES[@]:-}"; then
    SELECTED_INDEXES+=("${index}")
  fi
}

select_all_skills() {
  local i=0
  SELECTED_INDEXES=()
  for ((i = 0; i < ${#SKILL_NAMES[@]}; i++)); do
    SELECTED_INDEXES+=("${i}")
  done
}

select_requested_skills() {
  local requested=""
  local index=""

  for requested in "${REQUESTED_SKILLS[@]}"; do
    if ! index="$(find_skill_index "${requested}")"; then
      die "skill not found: ${requested}"
    fi
    add_selected_index "${index}"
  done
}

select_interactive_skills() {
  local answer=""
  local normalized=""
  local part=""
  local index=""
  local parts=()

  print_skills
  [[ "${#SKILL_NAMES[@]}" -gt 0 ]] || exit 0

  if [[ "${ASSUME_YES}" == "1" ]]; then
    select_all_skills
    return
  fi

  answer="$(prompt_read "Choose skills by number/name, comma separated, or 'all' [all]: ")"
  answer="${answer:-all}"

  if [[ "${answer}" == "a" || "${answer}" == "A" || "${answer}" == "all" || "${answer}" == "ALL" || "${answer}" == "*" ]]; then
    select_all_skills
    return
  fi

  normalized="$(printf '%s' "${answer}" | tr ' ' ',')"
  IFS=',' read -r -a parts <<< "${normalized}"

  for part in "${parts[@]}"; do
    [[ -n "${part}" ]] || continue
    if ! index="$(find_skill_index "${part}")"; then
      die "skill not found: ${part}"
    fi
    add_selected_index "${index}"
  done

  [[ "${#SELECTED_INDEXES[@]}" -gt 0 ]] || die "no skills selected"
}

HOSTS=()

add_host() {
  local host="$1"

  if ! array_contains "${host}" "${HOSTS[@]:-}"; then
    HOSTS+=("${host}")
  fi
}

auto_detect_hosts() {
  HOSTS=()

  if command -v codex >/dev/null 2>&1 || [[ -d "${CODEX_DEST}" ]]; then
    add_host "codex"
  fi

  if command -v claude >/dev/null 2>&1 || [[ -d "${CLAUDE_DEST}" ]]; then
    add_host "claude"
  fi

  if [[ "${#HOSTS[@]}" -eq 0 ]]; then
    add_host "codex"
    add_host "claude"
  fi
}

choose_hosts() {
  local answer=""

  case "${HOST}" in
    codex)
      HOSTS=("codex")
      return
      ;;
    claude)
      HOSTS=("claude")
      return
      ;;
    both)
      HOSTS=("codex" "claude")
      return
      ;;
    auto)
      auto_detect_hosts
      return
      ;;
  esac

  if [[ "${ASSUME_YES}" == "1" ]]; then
    auto_detect_hosts
    return
  fi

  log "Install targets:"
  log "  1. Codex       ${CODEX_DEST}"
  log "  2. Claude Code ${CLAUDE_DEST}"
  log "  3. Both"
  log "  4. Auto-detect"
  answer="$(prompt_read "Choose target [4]: ")"
  answer="${answer:-4}"

  case "${answer}" in
    1|codex|Codex) HOSTS=("codex") ;;
    2|claude|Claude) HOSTS=("claude") ;;
    3|both|Both|all|All) HOSTS=("codex" "claude") ;;
    4|auto|Auto) auto_detect_hosts ;;
    *) die "unknown target choice: ${answer}" ;;
  esac
}

host_dest() {
  case "$1" in
    codex) printf '%s' "${CODEX_DEST}" ;;
    claude) printf '%s' "${CLAUDE_DEST}" ;;
    *) die "unknown host: $1" ;;
  esac
}

backup_existing() {
  local path="$1"
  local backup=""
  local stamp=""

  stamp="$(date +%Y%m%d%H%M%S)"
  backup="${path}.backup.${stamp}"

  if [[ "${DRY_RUN}" == "1" ]]; then
    printf 'Would backup %s -> %s\n' "${path}" "${backup}"
  else
    mv "${path}" "${backup}"
  fi
}

install_skill() {
  local host="$1"
  local skill_index="$2"
  local root=""
  local name=""
  local src=""
  local dest=""

  root="$(host_dest "${host}")"
  name="${SKILL_NAMES[$skill_index]}"
  src="${SKILL_PATHS[$skill_index]}"
  dest="${root}/${name}"

  if [[ -L "${dest}" ]]; then
    if [[ "${DRY_RUN}" == "1" ]]; then
      printf 'Would relink %-25s -> %s\n' "${name}" "${dest}"
      return
    fi
    rm -f "${dest}"
  elif [[ -e "${dest}" ]]; then
    if [[ "${OVERWRITE}" != "1" ]]; then
      printf 'Skip %-28s -> %s (already exists)\n' "${name}" "${dest}"
      return
    fi
    backup_existing "${dest}"
  fi

  if [[ "${DRY_RUN}" == "1" ]]; then
    printf 'Would %s %-25s -> %s\n' "${INSTALL_MODE}" "${name}" "${dest}"
    return
  fi

  mkdir -p "${root}"

  if [[ "${INSTALL_MODE}" == "copy" ]]; then
    mkdir -p "${dest}"
    cp -R "${src}/." "${dest}/"
    printf '%s\n' "${src}" > "${dest}/.skill-collection-source"
  else
    ln -s "${src}" "${dest}"
  fi

  printf '%-6s %-27s -> %s\n' "${INSTALL_MODE}" "${name}" "${dest}"
}

discover_skills

if [[ "${LIST_ONLY}" == "1" ]]; then
  print_skills
  exit 0
fi

[[ "${#SKILL_NAMES[@]}" -gt 0 ]] || die "no installable skills found in ${SKILLS_DIR}"

if [[ "${SELECT_ALL}" == "1" ]]; then
  select_all_skills
elif [[ "${#REQUESTED_SKILLS[@]}" -gt 0 ]]; then
  select_requested_skills
else
  select_interactive_skills
fi

choose_hosts

log ""
log "Installing ${#SELECTED_INDEXES[@]} skill(s) to ${#HOSTS[@]} host(s) using ${INSTALL_MODE} mode."

for host in "${HOSTS[@]}"; do
  log ""
  log "Host: ${host} ($(host_dest "${host}"))"
  for index in "${SELECTED_INDEXES[@]}"; do
    install_skill "${host}" "${index}"
  done
done

log ""
log "Done. Restart Codex or Claude Code to pick up newly installed skills."
